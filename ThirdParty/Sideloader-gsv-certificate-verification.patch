diff --git a/build-macos-cli.sh b/build-macos-cli.sh
index a1d52e1..f4a0bf9 100755
--- a/build-macos-cli.sh
+++ b/build-macos-cli.sh
@@ -15,6 +15,31 @@ source "$LDC_ACTIVATE"
 cd "$ROOT/frontends/cli"
 dub build --compiler=ldc2 --build=release
 BIN="$ROOT/bin/sideloader"
+
+# LDC embeds source locations in its runtime diagnostics even for release
+# builds. Replace the local home-directory prefix without changing byte
+# lengths, so the distributed binary does not disclose the builder's account.
+python3 - "$BIN" "$HOME" <<'PY'
+from pathlib import Path
+import sys
+
+binary = Path(sys.argv[1])
+home = sys.argv[2].encode()
+if len(home) < len(b"/build"):
+    raise SystemExit("home directory path is too short to sanitize")
+
+replacement = b"/build" + b"_" * (len(home) - len(b"/build"))
+data = binary.read_bytes()
+binary.write_bytes(data.replace(home, replacement))
+PY
+
+codesign --force --sign - "$BIN"
+
+if LC_ALL=C strings -a "$BIN" | grep -F -- "$HOME" >/dev/null; then
+  echo "failed to remove local build paths from $BIN" >&2
+  exit 1
+fi
+
 chmod +x "$BIN" "$ROOT/sideloader"
 echo "built $BIN (run via $ROOT/sideloader)"
 otool -L "$BIN"
diff --git a/frontends/cli/source/certificate.d b/frontends/cli/source/certificate.d
index 0e9b958..0b53017 100644
--- a/frontends/cli/source/certificate.d
+++ b/frontends/cli/source/certificate.d
@@ -24,6 +24,7 @@ import argparse;
 
 import plist;
 import server.developersession;
+import sideload.certificateidentity;
 
 import cli_frontend;
 
@@ -35,13 +36,58 @@ struct CertificateCommand
         return cmd.match!(
                 (ListCerts cmd) => cmd(),
                 (HistoryCerts cmd) => cmd(),
+                (VerifyCert cmd) => cmd(),
                 (SubmitCert cmd) => cmd(),
                 (RevokeCert cmd) => cmd()
         );
     }
 
     @SubCommands
-    SumType!(ListCerts, HistoryCerts, SubmitCert, RevokeCert) cmd;
+    SumType!(ListCerts, HistoryCerts, VerifyCert, SubmitCert, RevokeCert) cmd;
+}
+
+@(Command("verify").Description("Verify a saved signing certificate is still registered for a team."))
+struct VerifyCert
+{
+    mixin LoginCommand;
+
+    @(NamedArgument("team").Description("Apple Developer Team ID.").Required())
+    string teamId;
+
+    @(NamedArgument("gsv").Description("Emit a machine-readable verification result for GSV."))
+    bool gsv = false;
+
+    int opCall()
+    {
+        auto log = getLogger();
+        string configurationPath = systemConfigurationPath();
+
+        scope provisioningData = initializeADI(configurationPath);
+        scope adi = provisioningData.adi;
+        scope akDevice = provisioningData.device;
+        auto appleAccount = login(akDevice, adi);
+        if (!appleAccount) {
+            return 1;
+        }
+
+        auto teams = appleAccount.listTeams().unwrap().filter!((team) => team.teamId == teamId).array();
+        if (teams.empty) {
+            log.error("The selected Apple Developer team is no longer available.");
+            return 1;
+        }
+
+        try {
+            scope identity = new CertificateIdentity(configurationPath, appleAccount, teams[0], true, true);
+        } catch (Exception e) {
+            log.errorF!"The saved certificate is not valid for this team: %s"(e.msg);
+            return 1;
+        }
+
+        if (gsv) {
+            writefln!"GSV_CERT_VERIFY\t%s\tVALID"(teamId);
+        }
+        return 0;
+    }
 }
 
 @(Command("history").Description("List locally saved signing certificates without logging in."))
