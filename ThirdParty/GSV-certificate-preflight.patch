+func verifiedSavedCertificates(_ certificates: [SavedCertificate]) -> [SavedCertificate] {
+    guard !certificates.isEmpty else { return [] }
+
+    info(localized("正在验证本地历史签名证书", "Verifying saved signing certificates"))
+    return certificates.filter { certificate in
+        guard let teamID = certificate.teamID else { return false }
+        let logURL = outputURL.appendingPathComponent("gsv-cert-verify-\(teamID).log")
+        do {
+            let status = try runLogged(
+                sideloaderURL.path,
+                ["cert", "verify", "--team", teamID, "--gsv"],
+                logURL: logURL,
+                activity: localized("正在验证历史签名证书…", "Verifying saved signing certificates…")
+            )
+            let result = (try? String(contentsOf: logURL, encoding: .utf8)) ?? ""
+            let marker = "GSV_CERT_VERIFY\t\(teamID)\tVALID"
+            guard status == 0, result.contains(marker) else {
+                warn(localized("已跳过失效或不属于当前帐号的历史证书（Team ID: \(teamID)）。", "Skipped a saved certificate that is invalid or unavailable for the current account (Team ID: \(teamID))."))
+                return false
+            }
+            return true
+        } catch {
+            warn(localized("无法验证历史证书（Team ID: \(teamID)），不会提供它用于签名。", "Could not verify the saved certificate (Team ID: \(teamID)); it will not be offered for signing."))
+            return false
+        }
+    }
+}
